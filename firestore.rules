rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio content collections (projects, skills, site_settings, contacts, privacy_policy)
    // Anyone can read, but only authenticated admin can create, update, or delete
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public anonymous visitors can record page views & analytics counters
    // Only authenticated admin can delete/reset analytics
    match /analytics_summary/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
    match /analytics_daily/{date} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}
