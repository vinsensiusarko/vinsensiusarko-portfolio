rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read portfolio content (projects, skills, profile, contacts)
    // Only authenticated admin can create, update, or delete content
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                      (request.auth.token.email == 'me@vinsensiusarka.id' || 
                       request.auth.token.email == 'vinsensiusarka@gmail.com');
    }
  }
}
